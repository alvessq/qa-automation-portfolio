# Copie para .env para sobrescrever os padrões.

# Por padrão o painel só escuta em localhost: ele executa comandos na máquina.
HOST=127.0.0.1
PORT=7400

# Fuso usado nas janelas de horário dos jobs
SCHEDULER_TZ=America/Sao_Paulo

# Começa com todos os jobs pausados (útil ao abrir o painel só para consultar)
START_PAUSED=false

# Quantas execuções manter no histórico
HISTORY_LIMIT=200

# --- Triagem de falhas (opcional) ---
# Quantas vezes repetir um job com "triage": true antes de dar o veredito
TRIAGE_RETRIES=3

# Abre issue no GitHub para bug confirmado (token fine-grained com Issues: read and write).
# Sem as duas variáveis, o veredito aparece só no painel.
GITHUB_REPOSITORY=
GITHUB_TOKEN=

# Aviso curto para qualquer veredito (Slack, Teams ou Discord)
TRIAGE_WEBHOOK_URL=
