# Copie para .env para sobrescrever os padrões.

# Por padrão o painel só escuta em localhost: ele executa comandos na máquina.
HOST=127.0.0.1

# Login do painel. Obrigatório se HOST não for localhost: sem ele o painel não sobe.
PANEL_USER=
PANEL_PASSWORD=
PORT=7400

# Fuso usado nas janelas de horário dos jobs
SCHEDULER_TZ=America/Sao_Paulo

# A agenda começa pausada: abrir o painel não dispara nenhuma suíte.
# false liga a agenda na subida. Na CI (CI=true) ela nunca começa pausada.
START_PAUSED=true

# Quantas execuções manter no histórico
HISTORY_LIMIT=200

# --- Triagem de falhas (opcional) ---
# Quantas vezes repetir um job com "triage": true antes de dar o veredito
TRIAGE_RETRIES=3

# Repositório no GitHub (dono/nome). Com ele o painel mostra as execuções na nuvem.
# Token fine-grained com Issues: read and write (bug confirmado vira issue) e
# Actions: read and write (disparar workflows pelo painel e pelos jobs de nuvem).
# Sem token: só leitura das execuções; vereditos da triagem ficam só no painel.
GITHUB_REPOSITORY=
GITHUB_TOKEN=

# Aviso curto para qualquer veredito (Slack, Teams ou Discord)
TRIAGE_WEBHOOK_URL=

# --- Preparação do celular ao abrir o painel ---
# Sem valor: prepara só se houver job mobile ativo. true: sempre. false: nunca.
# Preparar = baixar o APK se saiu versão nova e ligar um emulador se nenhum device estiver online.
PREPARE_MOBILE=
