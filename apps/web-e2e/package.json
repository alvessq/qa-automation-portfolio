{
  "name": "web-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Testes E2E web do Sauce Demo (saucedemo.com) com Playwright + TypeScript.",
  "type": "module",
  "scripts": {
    "browsers:install": "playwright install --with-deps chromium",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "spec:login": "playwright test tests/login.spec.ts",
    "spec:inventory": "playwright test tests/inventory.spec.ts",
    "spec:cart": "playwright test tests/cart.spec.ts",
    "spec:checkout": "playwright test tests/checkout.spec.ts",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "health": "node scripts/health.mjs",
    "health:pagina": "node scripts/health.mjs pagina",
    "health:app": "node scripts/health.mjs app",
    "health:estilos": "node scripts/health.mjs estilos",
    "health:catalogo": "node scripts/health.mjs catalogo",
    "health:imagens": "node scripts/health.mjs imagens",
    "test:unit": "node --test \"scripts/**/*.test.mjs\""
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "dotenv": "^17.2.0",
    "typescript": "^5.9.0"
  }
}
