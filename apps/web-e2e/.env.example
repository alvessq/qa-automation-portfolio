# Copie para .env para sobrescrever os padrões. O .env nunca vai para o Git.

BASE_URL=https://www.saucedemo.com

# Usuários de teste. Os padrões são as credenciais públicas exibidas na tela de login do Sauce Demo.
SAUCE_STANDARD_USER=standard_user
SAUCE_LOCKED_USER=locked_out_user
SAUCE_PASSWORD=secret_sauce

# Timeout do health check em milissegundos
HEALTH_TIMEOUT_MS=15000
