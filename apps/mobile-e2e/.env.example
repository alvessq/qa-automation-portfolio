# Copie para .env e ajuste ao seu ambiente. O .env nunca vai para o Git.

# Device alvo (veja `adb devices`). Se vazio, o Appium usa o primeiro device conectado.
ANDROID_UDID=
ANDROID_DEVICE_NAME=Android Emulator
# Opcional: versão do Android (ex.: 14). Se vazio, o Appium aceita a versão do device.
ANDROID_PLATFORM_VERSION=

# Caminho do APK (baixado por `npm run apk:download`)
APP_PATH=./apps/my-demo-app.apk
# Versão do release público a baixar (vazio = último release)
MDA_RELEASE_TAG=

# Usuários de teste. Os padrões são as credenciais públicas exibidas no próprio app.
MDA_STANDARD_USER=bod@example.com
MDA_STANDARD_PASSWORD=10203040
MDA_LOCKED_USER=alice@example.com

# Evidências
RECORD_VIDEO=true
VIDEOS_TO_KEEP=5

# Pula o diagnóstico de ambiente antes dos testes (útil na CI)
SKIP_DOCTOR=false
